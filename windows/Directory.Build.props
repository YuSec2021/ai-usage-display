<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <RepositoryVersion>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../project.yml')), '(?s)^.*?MARKETING_VERSION:\s*([0-9]+\.[0-9]+\.[0-9]+).*$', '$1'))</RepositoryVersion>
    <RepositoryBuild>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../project.yml')), '(?s)^.*?CURRENT_PROJECT_VERSION:\s*([0-9]+).*$', '$1'))</RepositoryBuild>
    <Version>$(RepositoryVersion)</Version>
    <FileVersion>$(RepositoryVersion).$(RepositoryBuild)</FileVersion>
  </PropertyGroup>
</Project>
