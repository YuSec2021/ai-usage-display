<Window
    x:Class="AIUsage.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <NavigationView x:Name="navigation" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="用量" Tag="overview"><NavigationViewItem.Icon><SymbolIcon Symbol="ViewAll" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="历史" Tag="history"><NavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="设置" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
    </NavigationView>
  </Grid>
</Window>
